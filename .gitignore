# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.template

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sanity generated artifacts
/sanity/extract.json
/sanity.types.ts
/schema.json
.gstack/

# Sanity image cache (local seed only)
.sanity-image-cache.json

# Local AI assistant state
.claude/

# Graphify : on versionne graph.json, GRAPH_REPORT.md et manifest.json ;
# le reste (visualisation, cache, suivi de coût, fichiers propres à la machine) est local.
graphify-out/graph.html
graphify-out/cache/
graphify-out/cost.json
graphify-out/.graphify_*
